{
  "name": "tutorial-pmb",
  "private": true,
  "type": "module",
  "description": "Sumber video tutorial Modul PMB Civitas One (calon mahasiswa & penyelenggara).",
  "scripts": {
    "audio:camaba": "node build_audio.mjs calon-mahasiswa",
    "audio:panitia": "node build_audio.mjs penyelenggara",
    "naskah": "node build_naskah.mjs calon-mahasiswa && node build_naskah.mjs penyelenggara",
    "render:camaba": "node render.mjs calon-mahasiswa video ../tutorial-pmb-calon-mahasiswa.mp4",
    "render:panitia": "node render.mjs penyelenggara video ../tutorial-pmb-penyelenggara.mp4"
  },
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "msedge-tts": "^2.0.9",
    "playwright-core": "1.63.0"
  }
}
