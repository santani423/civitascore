APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=civitasone
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

SUPER_ADMIN_EMAIL=superadmin@civitasone.local
SUPER_ADMIN_PASSWORD=ChangeMe123!

FRONTEND_URL=http://localhost:5173

VITE_APP_NAME="${APP_NAME}"

# --- Modul PMB (app/Modules/Admission, config/pmb.php) ---
# Disk berkas pendaftar (privat). CAPTCHA: none | turnstile (wajib turnstile di production).
PMB_STORAGE_DISK=local
PMB_CAPTCHA_DRIVER=none
PMB_TURNSTILE_SITE_KEY=
PMB_TURNSTILE_SECRET=
# Gateway online: kosong = hanya transfer manual & loket; midtrans = aktifkan adapter Midtrans.
PMB_PAYMENT_GATEWAY=
PMB_MIDTRANS_SERVER_KEY=
PMB_MIDTRANS_PRODUCTION=false
# SMS/WhatsApp: log (tanpa kirim) | http (penyedia HTTP generik).
PMB_SMS_DRIVER=log
PMB_SMS_HTTP_ENDPOINT=
PMB_SMS_HTTP_TOKEN=
# HMAC callback nilai CBT eksternal.
PMB_CBT_WEBHOOK_SECRET=
PMB_FRONTEND_URL="${FRONTEND_URL}"
