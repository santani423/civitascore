##########################################################################
# Template .env untuk Niagahoster Shared Hosting (cPanel)
#
# Cara pakai:
# 1. Upload aplikasi ke server (biasanya di luar public_html, mis. domain.com/
#    lalu public_html diarahkan ke folder /public via symlink atau document root).
# 2. Copy file ini jadi ".env" di root aplikasi lalu isi semua nilai <GANTI_...>.
# 3. Jalankan: php artisan key:generate --force
# 4. Jalankan: php artisan config:cache && php artisan route:cache && php artisan view:cache
# 5. Buat cron job cPanel (tiap menit) untuk scheduler:
#    * * * * * php /home/USERNAME/domain.com/artisan schedule:run >> /dev/null 2>&1
# 6. Untuk queue, shared hosting tidak bisa jalankan worker persisten (queue:work
#    daemon). Pakai QUEUE_CONNECTION=database lalu tambahkan cron job terpisah:
#    * * * * * php /home/USERNAME/domain.com/artisan queue:work --stop-when-empty >> /dev/null 2>&1
##########################################################################

APP_NAME=CivitasOne
APP_ENV=production
# Generate ulang di server dengan: php artisan key:generate --force
APP_KEY=base64:GiJ5jMf4OxG2Bt9ew6eVeiA1qyDeBgwgfhBJKMs3gDQ=
APP_DEBUG=false
APP_URL=https://devbeoneatma.santani.dev/

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# Ambil detail ini dari cPanel > MySQL Databases (host biasanya "localhost")
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=u858331583_becivitas
DB_USERNAME=u858331583_becivitas
DB_PASSWORD=GWp7UFn1!

# Shared hosting Niagahoster umumnya TIDAK menyediakan Redis.
# Gunakan driver file/database sebagai gantinya.
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=file
# CACHE_PREFIX=

# Baris di bawah ini tidak dipakai di shared hosting (tidak ada Redis/Memcached),
# dibiarkan kosong/komentar untuk jaga-jaga jika suatu saat pindah ke VPS.
# MEMCACHED_HOST=127.0.0.1
# REDIS_CLIENT=predis
# REDIS_HOST=127.0.0.1
# REDIS_PASSWORD=null
# REDIS_PORT=6379

# WAJIB diganti, jangan pakai kredensial default di production

SUPER_ADMIN_EMAIL=superadmin@civitasone.local
SUPER_ADMIN_PASSWORD=ChangeMe123!

FRONTEND_URL=http://localhost:5173

# Isi dari cPanel > Email Accounts (buat akun email dulu, mis. no-reply@domain.com)
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
