# Browser selalu memanggil /api/v1 (same-origin). Target backend diatur lewat API_PROXY_TARGET.
API_PROXY_TARGET=http://localhost:8000
VITE_APP_NAME="CivitasOne"

# Landing page (/) — all optional. Leave empty until the official channel is confirmed;
# the page then says contact details are not available yet instead of showing a placeholder.
# Demo requests and "Hubungi Tim Kami" open a pre-filled email draft to this address.
VITE_LANDING_CONTACT_EMAIL=
# Shown in the footer when set, e.g. "+62 21 0000 0000".
VITE_LANDING_CONTACT_PHONE=
# Production origin (no trailing slash) — enables canonical and og:url tags.
VITE_LANDING_SITE_URL=
