# Contoh nginx untuk frontend (static dist) + reverse proxy API.
server {
    listen 443 ssl;
    server_name domainfe.example;
    root /var/www/frontend/dist;

    client_max_body_size 50m;   # upload dokumen/gambar

    location /api/ {
        proxy_pass https://beoneatma.santani.dev;   # target tetap
        proxy_ssl_server_name on;                    # SNI; verifikasi TLS tetap aktif
        proxy_set_header Host beoneatma.santani.dev;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_redirect https://beoneatma.santani.dev/ /;  # redirect backend tidak bocor ke browser
        proxy_read_timeout 60s;
        proxy_request_buffering off;
    }

    location / {
        try_files $uri /index.html;
    }
}
