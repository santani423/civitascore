# Contoh nginx untuk frontend (static dist). Browser memanggil backend langsung
# lewat VITE_API_BASE_URL, jadi tidak ada reverse proxy /api di sini.
server {
    listen 443 ssl;
    server_name domainfe.example;
    root /var/www/frontend/dist;

    location / {
        try_files $uri /index.html;
    }
}
