# React SPA (react-router-dom) - Apache config

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Jangan redirect request untuk file/folder yang benar-benar ada
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Semua route lain diarahkan ke index.html agar client-side routing bekerja
  RewriteRule ^ index.html [L]
</IfModule>

# Cache aset statis (hash di nama file, aman untuk cache lama)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

# Kompresi
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
